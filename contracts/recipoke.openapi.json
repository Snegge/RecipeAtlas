    "/api/auth/login": {
      "post": {
        "parameters": [
          {
            "description": "Existing browser write protection; value must be 1.",
            "in": "header",
            "name": "X-RecipeAtlas",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Missing write header"
          }
        },
        "tags": [
          "Recipoke.Api"
